# Copy this file to .env.local and fill in real values.
# Never commit .env.local, it's already in .gitignore.

# Cloudflare D1 — get these from `wrangler d1 create engsoc-platform-db`
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_D1_DATABASE_ID=
CLOUDFLARE_D1_TOKEN=

# Cloudflare R2 — get these from the Cloudflare dashboard, R2 > Manage API tokens
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=engsoc-platform-files

# Better Auth — generate a secret with `openssl rand -base64 32`
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# Resend — get this from resend.com after verifying a sending domain
RESEND_API_KEY=

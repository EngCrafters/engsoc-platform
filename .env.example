# Copy this file to .env.local and fill in real values.
# Never commit .env.local, it's already in .gitignore.

# Supabase — get these from the Supabase dashboard, Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Direct Postgres connection, for Drizzle migrations — Project Settings > Database
DATABASE_URL=

# Resend — get this from resend.com after verifying a sending domain
RESEND_API_KEY=

# Staging Supabase project — only used by tests/rls-staging-anon.test.ts to
# prove the RLS policies in docs/adr/0006 actually hold, using the real
# anon key against real staging data. Deliberately separate from the
# NEXT_PUBLIC_SUPABASE_* vars above (main project doesn't have these
# policies yet). Get these from the staging project's dashboard, Project
# Settings > API — the URL and anon key only, never a service role key.
STAGING_SUPABASE_URL=
STAGING_SUPABASE_ANON_KEY=

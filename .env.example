# Copy this file to .env.local and fill in real values.
# Never commit .env.local, it's already in .gitignore.

# Supabase — get these from the Supabase dashboard, Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# SERVER ONLY. Used solely by lib/auth/admin.ts for the Technical-only user
# administration (create/invite users, temporary passwords). Never expose it to
# the browser or commit it. Set it as a sensitive Vercel variable.
SUPABASE_SERVICE_ROLE_KEY=

# Restricted application-runtime Postgres connection (the `app_runtime` role
# created by the UC-02 security migration). Keep this separate from the
# migration connection and use the transaction pooler endpoint.
APP_RUNTIME_DATABASE_URL=

# Direct Postgres connection, for Drizzle migrations only — Project Settings > Database
DATABASE_URL=

# Reserved for future application-originated transactional email. Current Auth
# email uses Resend SMTP configured in Supabase, not this application variable.
RESEND_API_KEY=

# Staging Supabase project — only used by tests/rls-staging-anon.test.ts to
# prove the RLS policies in docs/adr/0006 actually hold, using the real
# anon key against real staging data. Deliberately separate from the
# NEXT_PUBLIC_SUPABASE_* vars above. Get these from the staging project's dashboard, Project
# Settings > API — the URL and anon key only, never a service role key.
STAGING_SUPABASE_URL=
STAGING_SUPABASE_ANON_KEY=

# Fixed public origin used only for Supabase password-recovery callbacks.
# Add its /auth/callback URL to Supabase Auth's redirect allow-list. This is
# deliberately separate from request headers so recovery redirects cannot be
# steered by an untrusted Host value.
AUTH_REDIRECT_ORIGIN=

# Server-only canonical application origin for same-origin POST validation.
# Required in production: https://engsoc-platform.vercel.app
# Never derive this trust boundary from Host/x-forwarded-host/VERCEL_URL.
# Without this variable, development supports loopback request origins only.
APP_ORIGIN=

# Secret-gated live staging M5 smoke test. The password is never committed or
# printed. Set RUN_STAGING_MANAGER_AUTH_TESTS=true only in a controlled local
# or CI environment after the staging manager account is provisioned.
STAGING_M5_MANAGER_EMAIL=uc02-m5-manager@staging.engcrafters.test
STAGING_M5_MANAGER_PASSWORD=
RUN_STAGING_MANAGER_AUTH_TESTS=false

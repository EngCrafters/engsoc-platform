# Normalize line endings for cross-platform work.
#
# Without this file a Windows clone with core.autocrlf=true checks out CRLF
# while the repository stores LF, so `npm run format:check` (Prettier defaults
# to endOfLine: "lf") reports every tracked file as unformatted. CI runs on
# Linux and never saw the problem. This makes the working tree LF everywhere.
* text=auto eol=lf

# Binary assets are never line-ending converted.
*.png binary
*.jpg binary
*.jpeg binary
*.webp binary
*.gif binary
*.ico binary
*.pdf binary
*.jfif binary
*.woff binary
*.woff2 binary
*.ttf binary
*.otf binary

# Keep generated lockfiles exactly as the package manager writes them.
package-lock.json text eol=lf

# Windows-only helper scripts must keep CRLF if any are ever added.
*.cmd text eol=crlf
*.bat text eol=crlf
*.ps1 text eol=crlf

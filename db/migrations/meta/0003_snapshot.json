        "events_title_bounds": {
          "name": "events_title_bounds",
          "value": "\"events\".\"title\" = btrim(\"events\".\"title\") AND char_length(\"events\".\"title\") BETWEEN 1 AND 200"
        },
        "events_description_bounds": {
          "name": "events_description_bounds",
          "value": "\"events\".\"description\" IS NULL OR char_length(\"events\".\"description\") <= 10000"
        },
        "events_location_bounds": {
          "name": "events_location_bounds",
          "value": "\"events\".\"location\" IS NULL OR char_length(\"events\".\"location\") <= 500"
        },
        "events_published_requires_description": {
          "name": "events_published_requires_description",
          "value": "\"events\".\"status\" = 'draft' OR (\"events\".\"description\" IS NOT NULL AND char_length(btrim(\"events\".\"description\")) > 0)"
        },
        "events_capacity_positive": {
          "name": "events_capacity_positive",
          "value": "\"events\".\"capacity\" > 0"
        },
        "events_revision_positive": {
          "name": "events_revision_positive",
          "value": "\"events\".\"revision\" > 0"
        },
        "events_review_state": {
          "name": "events_review_state",
          "value": "(\"events\".\"review_required\" = true AND \"events\".\"flagged_by\" IS NOT NULL) OR (\"events\".\"review_required\" = false AND \"events\".\"flagged_by\" IS NULL AND \"events\".\"approved_by\" IS NULL AND \"events\".\"approved_at\" IS NULL AND \"events\".\"approved_revision\" IS NULL)"
        },
        "events_approval_all_or_nothing": {
          "name": "events_approval_all_or_nothing",
          "value": "(\"events\".\"approved_by\" IS NULL AND \"events\".\"approved_at\" IS NULL AND \"events\".\"approved_revision\" IS NULL) OR (\"events\".\"approved_by\" IS NOT NULL AND \"events\".\"approved_at\" IS NOT NULL AND \"events\".\"approved_revision\" IS NOT NULL)"
        },
        "events_no_self_approval": {
          "name": "events_no_self_approval",
          "value": "\"events\".\"approved_by\" IS NULL OR \"events\".\"flagged_by\" IS NULL OR \"events\".\"approved_by\" <> \"events\".\"flagged_by\""
        }
      },
      "isRLSEnabled": false
    },
